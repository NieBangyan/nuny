# Copy to .env. Values use Java .properties syntax: no surrounding quotes.
# Keep .env in the working directory when starting the application.
DB_URL=jdbc:mysql://127.0.0.1:3306/your_database?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
DB_USERNAME=your_database_user
DB_PASSWORD=replace_me
DRUID_USERNAME=monitor_admin
DRUID_PASSWORD=replace_with_separate_password

# Deployment reference only; these are not used by the application.
SERVER_HOST=your_server_ip
SERVER_PRIVATE_HOST=your_private_ip
SSH_PORT=22
SSH_USERNAME=your_ssh_user
SSH_PASSWORD=replace_me
PANEL_URL=https://your_server_ip:your_panel_port/your_entry
PANEL_PRIVATE_URL=https://your_private_ip:your_panel_port/your_entry
PANEL_USERNAME=your_panel_user
PANEL_PASSWORD=replace_me
APP_LOGIN_USERNAME=your_app_user
APP_INITIAL_PASSWORD=replace_me
